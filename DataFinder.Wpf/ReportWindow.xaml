<Window x:Class="DataFinder.Wpf.ReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Report" Height="400" Width="700"
        Loaded="Window_Loaded">
    <Grid Margin="16">
        <DataGrid x:Name="ReportGrid" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="SearchDate" Binding="{Binding SearchDate}"/>
                <DataGridTextColumn Header="SearchUrl" Binding="{Binding SearchUrl}" Width="*"/>
                <DataGridTextColumn Header="CountFoundTerm" Binding="{Binding CountFoundTerm}"/>
                <DataGridTextColumn Header="Searched Term" Binding="{Binding SearchedTerm}"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>